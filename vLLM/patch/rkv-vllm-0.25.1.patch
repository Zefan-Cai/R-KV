@@ -872,6 +877,70 @@ class VllmConfig:
         # To give each torch profile run a unique instance name.
         self.instance_id = f"{time.time_ns()}"
 
+        # R-KV (redundancy-aware KV compression) physically evicts and relocates
+        # KV in place. Prefix caching shares KV blocks across requests, so an
+        # in-place eviction in one request would corrupt the shared prefix of
+        # others. Disable prefix caching when R-KV is enabled (mirrors SGLang's
+        # required --disable-radix-cache).
+        if (
+            envs.VLLM_V1_R_KV_BUDGET > 0
+            and envs.VLLM_V1_R_KV_BUFFER > 0
+            and self.cache_config is not None
+            and self.cache_config.enable_prefix_caching
+        ):
+            logger.info_once(
+                "R-KV enabled: disabling prefix caching (in-place KV eviction "
+                "is incompatible with shared prefix blocks)."
+            )
+            self.cache_config.enable_prefix_caching = False
+
+        # R-KV compaction reports its per-request evicted-token count as a model
+        # output (``num_dropped_tokens``) that the scheduler must apply before
+        # the next step's *physical* KV positions are computed. Async scheduling
+        # prepares step N+1 before step N's output is processed, so immediately
+        # after a compaction the dropped-token count is stale for one step and
+        # the next decode token overwrites a surviving KV slot -- a
+        # batch-dependent cache corruption that only appears under the memory
+        # pressure of many concurrent requests. Force synchronous scheduling
+        # when R-KV is enabled so the eviction accounting is always current.
+        if (
+            envs.VLLM_V1_R_KV_BUDGET > 0
+            and envs.VLLM_V1_R_KV_BUFFER > 0
+            and self.scheduler_config is not None
+            and self.scheduler_config.async_scheduling is not False
+        ):
+            logger.info_once(
+                "R-KV enabled: disabling async scheduling (compaction's "
+                "dropped-token feedback must be applied before the next step's "
+                "KV positions are computed)."
+            )
+            self.scheduler_config.async_scheduling = False
+
+        # R-KV runs its scoring/eviction hooks *inside* the attention forward and
+        # compacts right after it. vLLM's default FULL / FULL_AND_PIECEWISE
+        # cudagraph **captures** the decode attention, so the R-KV Python hooks
+        # execute only once at capture and never on replay -- R-KV then silently
+        # no-ops (runs as Full-KV). PIECEWISE keeps attention eager (it is a
+        # graph *splitting* op) so the hooks fire every decode step while the
+        # rest of the layer is still graphed (~25% faster than full eager, same
+        # accuracy). Force PIECEWISE when R-KV is enabled and cudagraphs are on
+        # (a no-op under --enforce-eager, which sets cudagraph_mode = NONE).
+        if (
+            envs.VLLM_V1_R_KV_BUDGET > 0
+            and envs.VLLM_V1_R_KV_BUFFER > 0
+            and self.model_config is not None
+            and not self.model_config.enforce_eager
+            and self.compilation_config is not None
+            and self.compilation_config.cudagraph_mode != CUDAGraphMode.PIECEWISE
+        ):
+            logger.info_once(
+                "R-KV enabled: forcing PIECEWISE cudagraph (FULL cudagraph "
+                "captures the attention forward, so R-KV's in-forward hooks "
+                "would never run on replay and compaction would silently "
+                "no-op)."
+            )
+            self.compilation_config.cudagraph_mode = CUDAGraphMode.PIECEWISE
+
         if self.performance_mode != "balanced":
             logger.info_once("Performance mode set to '%s'.", self.performance_mode)
 
